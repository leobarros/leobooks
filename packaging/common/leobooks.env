# LeoBooks — configuração do serviço nativo.
# Edite e rode: sudo systemctl restart leobooks
#
# 127.0.0.1: apenas local. Para Tailscale/LAN use 0.0.0.0 ou o IP do Tailscale.
LEOBOOKS_BIND=127.0.0.1
LEOBOOKS_PORT=5057

# Dados persistentes (banco, capas, fotos, backups e chave de sessão).
LEOBOOKS_INSTANCE=/var/lib/leobooks

# Deixe 0 quando o acesso for HTTP; use 1 atrás de HTTPS.
LEOBOOKS_HTTPS=0

# Cada novo cadastro recebe o livro de exemplo.
LEOBOOKS_SAMPLE_BOOK=1

LEOBOOKS_LOG_LEVEL=INFO
