# Copie para .env e ajuste conforme o homelab.
# O .env não é versionado.

TZ=America/Sao_Paulo

# Interface e porta publicadas no host.
# 127.0.0.1 = apenas local (recomendado atrás de proxy reverso).
# 0.0.0.0   = acessível pela LAN.
LEOBOOKS_BIND_ADDR=127.0.0.1
LEOBOOKS_PUBLISH_PORT=5059

# Imagem publicada no Docker Hub: nickolback/leobooks
# Use uma tag de versão (ex.: 1.0.0) para releases imutáveis.
LEOBOOKS_IMAGE_TAG=latest

# Coloque 1 se acessar por HTTPS (proxy reverso com TLS).
LEOBOOKS_HTTPS=0

# Busca de capas em APIs públicas.
LEOBOOKS_COVER_LOOKUP=1
LEOBOOKS_LOOKUP_TIMEOUT=8

# 1 entrega "A Arte da Guerra" como livro de exemplo a cada novo cadastro.
LEOBOOKS_SAMPLE_BOOK=1

# Logs de auditoria (JSON em stdout) e arquivo opcional com rotação.
LEOBOOKS_LOG_LEVEL=INFO
# LEOBOOKS_AUDIT_LOG=/app/instance/logs/audit.log

# Opcional. Se vazio, a chave é gerada e persistida no volume.
# SECRET_KEY=troque-por-uma-chave-longa-e-aleatoria

# UID/GID do usuário do container (para volumes com permissões).
APP_UID=1000
APP_GID=1000

# true instala Tesseract + pytesseract na imagem (build mais pesado).
INSTALL_OCR=false
